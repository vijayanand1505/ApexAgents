# Copy to .env and fill in. .env.local, if present, wins over .env.
# Phase -1 only needs the OpenAI block. The full list arrives in Phase 0 (master.md §29).

# ── OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
MODEL_MASTER=gpt-6.1-sol
MODEL_BOT=gpt-6.1-sol
MODEL_VISION=gpt-6.1-sol
MODEL_DECISIONS=gpt-6-luna
# OPENAI_BASE_URL=https://api.openai.com/v1

# Use installed Google Chrome when bundled Chromium is unavailable (optional).
# PLAYWRIGHT_CHANNEL=chrome
